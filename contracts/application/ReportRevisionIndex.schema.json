{
  "$defs": {
    "ReportRevisionIndexItem": {
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 20,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "revision_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Revision Sha256",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
          "title": "Result Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 524288,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "revision_id",
        "sequence",
        "revision_sha256",
        "result_id",
        "result_sha256",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ReportRevisionIndexItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "title": "Session Id",
      "type": "string"
    },
    "data_generation": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Data Generation",
      "type": "integer"
    },
    "base_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Base Snapshot Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReportRevisionIndexItem"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "data_generation",
    "base_snapshot_sha256",
    "items"
  ],
  "title": "ReportRevisionIndex",
  "type": "object"
}
