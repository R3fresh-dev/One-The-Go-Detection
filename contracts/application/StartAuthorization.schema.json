{
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "device_boot_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Device Boot Id"
    },
    "device_nonce": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Nonce"
    }
  },
  "required": [
    "attempt_id",
    "device_boot_id"
  ],
  "title": "StartAuthorization",
  "type": "object"
}
