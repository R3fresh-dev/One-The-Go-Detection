{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "registry_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Registry Id",
      "type": "string"
    },
    "version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Version",
      "type": "string"
    },
    "expires_at": {
      "exclusiveMinimum": 0,
      "title": "Expires At",
      "type": "number"
    },
    "evidence_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evidence Ref",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "method_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Method Id",
      "type": "string"
    },
    "assay_bases": {
      "items": {
        "enum": [
          "free",
          "total_after_hydrolysis"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Assay Bases",
      "type": "array"
    },
    "collection_method_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Collection Method Ids",
      "type": "array"
    },
    "instrument_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Instrument Ids",
      "type": "array"
    },
    "laboratory_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Laboratory Ids",
      "type": "array"
    }
  },
  "required": [
    "registry_id",
    "version",
    "expires_at",
    "evidence_ref",
    "evidence_sha256",
    "method_id",
    "assay_bases",
    "collection_method_ids",
    "instrument_ids",
    "laboratory_ids"
  ],
  "title": "Method",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-the-go-detection.invalid/contracts/operator/method.schema.json",
  "description": "Maintenance submission only. Semantic identity, independent review, current dependencies and expiry are additionally enforced by otgd.operator_governance. This schema is not approval."
}
