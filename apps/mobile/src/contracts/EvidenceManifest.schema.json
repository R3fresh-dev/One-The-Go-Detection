          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "sha256"
      ],
      "title": "AttemptHash",
      "type": "object"
    },
    "Selection": {
