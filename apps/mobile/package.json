{
  "name": "one-the-go-detection-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8082",
    "android": "expo run:android --port 8082",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts src/device/tests/*.test.ts",
    "export:web": "expo export --platform web",
    "config:check": "expo config --type public",
    "fixtures:generate": "node --import tsx scripts/generate-contract-fixtures.ts",
    "test:e2e": "playwright test",
    "serve:web": "node scripts/serve-web.mjs",
    "format:check": "prettier --check App.tsx app.config.ts src/controller.ts src/core/profileForm.ts src/core/operationGuards.ts src/core/serializedVault.ts src/services tests e2e scripts",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@types/react": "~19.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "expo": "57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.10.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
