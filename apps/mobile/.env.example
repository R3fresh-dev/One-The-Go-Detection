# Local defaults. Physical phones need phone-reachable origins configured before signing.
APP_ENV=local
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_OAUTH_ISSUER=http://localhost:8081
EXPO_PUBLIC_OAUTH_CLIENT_ID=otgd-local-mobile
EXPO_PUBLIC_SERVERLESS=false
# QA/prod require real HTTPS origins and the configured Cognito public client.
# EAS_PROJECT_ID is assigned by your Expo account; no signing credentials are committed.
