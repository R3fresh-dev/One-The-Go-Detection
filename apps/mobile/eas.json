{
  "cli": {
    "version": "24.12.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "local" }
    },
    "qa": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_ENV": "qa",
        "EXPO_PUBLIC_APP_ENV": "qa",
        "EXPO_PUBLIC_HOSTED_PREVIEW": "false",
        "EXPO_NO_DOTENV": "1"
      }
    },
    "qa-store": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "APP_ENV": "qa",
        "EXPO_PUBLIC_APP_ENV": "qa",
        "EXPO_PUBLIC_HOSTED_PREVIEW": "false",
        "EXPO_NO_DOTENV": "1"
      },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "APP_ENV": "prod",
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_HOSTED_PREVIEW": "false",
        "EXPO_NO_DOTENV": "1"
      },
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false },
      "autoIncrement": true
    }
  },
  "submit": {
    "qa-store": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {}
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {}
    }
  }
}
